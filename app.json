{
  "expo": {
    "name": "영원가계부",
    "slug": "zero_budget",
    "version": "1.0.0",
    "scheme": "zerobudget",
    "ios": {
      "bundleIdentifier": "com.yeongwon.app",
      "supportsTablet": true
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.yeongwon.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "결제 사진을 캡처에 첨부하려면 사진 접근 권한이 필요해요.",
          "cameraPermission": "결제 직후 바로 촬영하려면 카메라 접근 권한이 필요해요.",
          "microphonePermission": "짧은 영상을 촬영하려면 마이크 접근 권한이 필요해요."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png"
        }
      ]
    ]
  }
}
